# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canonical deployment origin used for OAuth redirects and origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: disable demo mode even when Supabase is not configured.
NEXT_PUBLIC_ENABLE_DEMO=true
