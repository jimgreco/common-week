# Local PostgreSQL. The browser never receives this connection string.
DATABASE_URL=postgresql://common_week_app:change-me@127.0.0.1:5432/common_week
PGSSL=false

# Set true to use the interactive in-memory demo without authentication or storage.
ENABLE_DEMO=true

# Google web OAuth credentials. Never prefix these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Exact public origin used for OAuth redirects. No trailing path.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sign in with Apple. APPLE_PRIVATE_KEY may contain literal \n sequences.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_BASE64=
APPLE_SERVICE_ID=
APPLE_BUNDLE_ID=com.jimgreco.commonweek

# Household invitation delivery (https://resend.com).
RESEND_API_KEY=
INVITATION_EMAIL_FROM=Week of Us <invites@weekofus.com>
NOTIFICATION_EMAIL_FROM=Week of Us <notifications@weekofus.com>

# Native push delivery. Use an Apple Push Notifications authentication key;
# the Sign in with Apple key is a separate credential.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_BASE64=
APNS_BUNDLE_ID=com.jimgreco.commonweek

# Optional override for HTTPS termination/testing. By default this follows NEXT_PUBLIC_APP_URL.
# SESSION_COOKIE_SECURE=false
