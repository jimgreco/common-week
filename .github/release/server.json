{
  "app": "common-week",
  "image": "ghcr.io/jimgreco/common-week",
  "images": [
    {
      "context": ".",
      "dockerfile": "Dockerfile",
      "build_args": {
        "APP_BUILD": "{sha}",
        "NEXT_PUBLIC_APP_URL": "https://weekofus.com"
      }
    }
  ],
  "profile": "common-week",
  "services": {
    "common-week": {
      "metadata_env": { "APP_BUILD": "{sha}" },
      "health": [
        "node",
        "-e",
        "fetch('http://127.0.0.1:3000/api/health').then(async r=>{const b=await r.json();process.exit(r.ok&&b.status==='ok'&&b.database==='ready'&&b.build==='{sha}'&&process.env.APP_BUILD==='{sha}'?0:1)}).catch(()=>process.exit(1))"
      ]
    }
  },
  "interpolate_from_live": {
    "COMMON_WEEK_IMAGE": "image:common-week",
    "COMMON_WEEK_APP_BUILD": "env:common-week:APP_BUILD",
    "COMMON_WEEK_APP_URL": "env:common-week:NEXT_PUBLIC_APP_URL"
  },
  "preflight": [
    { "service": "common-week", "command": ["node", "scripts/check-offline-recovery-role.mjs", "--before-migration"] }
  ],
  "migrate": {
    "stop_first": true,
    "commands": [
      { "service": "common-week", "command": ["node", "scripts/migrate.mjs"] },
      { "service": "common-week", "command": ["node", "scripts/check-offline-recovery-role.mjs", "--require-compatible"] }
    ]
  },
  "on_failure_after_migration": "stop",
  "refuse_backwards": true
}
